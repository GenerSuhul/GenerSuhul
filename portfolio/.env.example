# Variables de entorno para visitas
# Almacenamiento Redis compatible con Upstash REST:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cadena aleatoria privada, larga y única para limitar registros repetidos:
VISIT_HASH_SECRET=
# Resend: dirección remitente de un dominio verificado y clave de API:
RESEND_API_KEY=
VISIT_FROM_EMAIL=
